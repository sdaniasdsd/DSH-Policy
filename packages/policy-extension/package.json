{
  "name": "@deepseek-ai/dsh-policy-extension",
  "description": "Policy strategy and feedback extension for official DSH",
  "version": "1.0.4",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdaniasdsd/DSH-Policy.git",
    "directory": "packages/policy-extension"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./compatibility.json": "./compatibility.json",
    "./dsh.bundle.patch.yml": "./dsh.bundle.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "compatibility.json",
    "dsh.bundle.patch.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.bundle.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.host.json tsconfig.client.json && tsdown --config-loader native"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-jobs": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-workflow": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-locale": "file:../../packages/client/locale",
    "@deepseek-ai/dsh-client-ui-conversation": "file:../../packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-settings": "file:../../packages/client/ui-settings",
    "@deepseek-ai/dsh-client-ui-renderer": "file:../../packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "file:../../packages/client/ui-slots",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  }
}
